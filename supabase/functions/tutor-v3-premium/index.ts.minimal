import { serve } from "https://deno.land/std@0.224.0/http/server.ts";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type, x-correlation-id",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

console.log("[TUTOR_BOOT_00_FILE_LOADED] ts=" + new Date().toISOString());

serve(async (req) => {
  console.log("[TUTOR_REQ_01_RECEIVED] method=" + req.method);

  if (req.method === "OPTIONS") {
    console.log("[TUTOR_REQ_02_OPTIONS_HANDLED]");
    return new Response("ok", { headers: corsHeaders });
  }

  try {
    const rawBody = await req.text();
    console.log("[TUTOR_REQ_03_BODY_TEXT_OK] len=" + rawBody.length);
    
    return new Response(JSON.stringify({
      success: true,
      ok: true,
      content: "Tutor V3 healthcheck OK. A função carregou corretamente (VERSÃO MÍNIMA).",
      stage: "minimal_runtime_ok",
      timestamp: new Date().toISOString()
    }), {
      status: 200,
      headers: {
        ...corsHeaders,
        "Content-Type": "application/json"
      }
    });
  } catch (err) {
    console.error("[TUTOR_REQ_ERROR]", err.message);
    return new Response(JSON.stringify({ error: err.message }), {
      status: 500,
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    });
  }
});
